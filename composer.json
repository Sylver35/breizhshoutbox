{
    "name": "sylver35/breizhshoutbox",
    "type": "phpbb-extension",
    "description": "Breizh Shoutbox Ajax Chat Extension for phpBB 3.3",
    "homepage": "https://breizhcode.com",
    "version": "1.8.4",
    "time": "2025-08-17",
    "keywords": ["phpbb", "extension", "breizh", "shoutbox", "ajax", "chat", "chatbox"],
    "license": "GPL-2.0-only",
    "authors": [{
            "name": "Sylver35",
            "homepage": "https://breizhcode.com",
            "email": "webmaster@breizhcode.com",
            "role": "Extension Developer"
        }],
    "require": {
        "php": ">=7.2",
        "ext-json": "*",
		"composer/installers": "~2.2.0",
        "phpbb/phpbb": ">=3.3.10"
    },
	 "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "extra": {
        "display-name": "Breizh Shoutbox",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.10"
        },
        "version-check": {
            "host": "breizhversions.com",
            "directory": "/breizhshoutbox",
            "filename": "version_check.json",
            "ssl": false
        }
    }
}
